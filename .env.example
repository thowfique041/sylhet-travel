# ---- Server (Express API) ----
# MongoDB connection string (MongoDB Atlas free tier works). Without it the API
# serves the bundled Sylhet content read-only and disables accounts/admin.
MONGODB_URI=
# Long random string used to sign login tokens. Required in production.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# First admin account, created automatically on first database connection.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: restrict CORS to these origins (comma separated). Same-origin on Vercel needs nothing.
CLIENT_ORIGIN=
# Optional: Cloudinary for admin image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PORT=5000

# ---- Client (Vite, public) ----
VITE_CONTACT_EMAIL=
VITE_FACEBOOK_URL=
VITE_INSTAGRAM_URL=
VITE_YOUTUBE_URL=
# Used for absolute URLs in sitemap.xml
SITE_URL=
